# ============ Supabase / PostgreSQL ============
# Pegue ambas as URLs em: Supabase Dashboard → botão "Connect" → aba "ORMs" → "Prisma".
# Substitua [YOUR-PASSWORD] pela senha do banco (Settings → Database).

# Pooler (PgBouncer, porta 6543) — usado em runtime pelo app.
DATABASE_URL="postgresql://postgres.PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432) — usada SOMENTE pelo `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============ JWT ============
# Mínimo 32 chars. Gere com:
#   PowerShell:  [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
#   Node:        node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-no-minimo-32-chars"
JWT_EXPIRES_IN="7d"

# ============ HTTP ============
PORT=3000
